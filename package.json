{
  "name": "test-physics-virtual-work",
  "version": "2.0.0",
  "description": "Виртуальная лаборатория - исследование свойств терморезистора",
  "author": "PMI-42: Startsev Dmitry, Pirozhkov Nikita, Feofanov Alexander, Ashirov Damir",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "@types/chart.js": "^2.9.41",
    "@types/three": "^0.182.0",
    "chart.js": "^4.5.1",
    "dat.gui": "^0.7.9",
    "three": "^0.182.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^8.2.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "typescript": "~5.4.5",
    "vite": "^5.4.10",
    "vue-tsc": "^2.0.29",
    "wait-on": "^7.2.0"
  },
  "build": {
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "appId": "com.PMI42.virtual-lab",
    "productName": "Виртуальная лаборатория",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!dist/**/*.map",
      "!**/*.tsbuildinfo"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["ia32"] },
        { "target": "portable", "arch": ["ia32"] }
      ],
      "icon": "public/favicon.ico",
      "publisherName": "PMI-42: Startsev Dmitry, Pirozhkov Nikita, Feofanov Alexander, Ashirov Damir"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Виртуальная лаборатория"
    }
  }
}